TZ=America/Bahia

POSTGRES_DB=provedor
POSTGRES_USER=provedor
POSTGRES_PASSWORD=

MONGO_ROOT_USER=genieacs
MONGO_ROOT_PASSWORD=

REDIS_PASSWORD=

# Gere com:
# openssl rand -hex 64
GENIEACS_UI_JWT_SECRET=

# Conta administrativa única do painel. Use uma senha longa e exclusiva.
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=
# Gerada localmente pelo bootstrap; usada para os logins admin/superadmin do CPE.
CPE_ADMIN_PASSWORD=
# Gere com: openssl rand -hex 64
API_SESSION_SECRET=
API_COOKIE_SECURE=false

# Configure a URI do PostgreSQL local apontando para RFN_Equipamentos.
DATABASE_URL=

# Copie a URI PostgreSQL em Supabase > Connect (use o Session pooler se necessário).
# A senha da conexão do banco é diferente da chave secreta da API.
SUPABASE_DB_URL=
