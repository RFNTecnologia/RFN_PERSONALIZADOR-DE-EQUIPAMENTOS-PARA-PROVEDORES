# Template only. Set real values as backend secrets; never commit real credentials.
# The endpoint must be reachable from the hosted Edge Function over HTTPS.
# Add Basic Auth at your HTTPS reverse proxy in front of GenieACS NBI.
GENIEACS_NBI_URL=https://acs.example.com
GENIEACS_NBI_USERNAME=replace-with-reverse-proxy-user
GENIEACS_NBI_PASSWORD=replace-with-a-long-random-password
