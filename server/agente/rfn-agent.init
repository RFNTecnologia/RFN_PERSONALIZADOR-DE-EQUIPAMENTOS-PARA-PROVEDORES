#!/bin/sh /etc/rc.common
# Servico do agente de restauracao (OpenWrt/procd).
# Instale em /etc/init.d/rfn-agent e habilite com: /etc/init.d/rfn-agent enable

START=95
STOP=10

USE_PROCD=1
PROG=/usr/bin/rfn-bootstrap

start_service() {
  procd_open_instance
  procd_set_param command "$PROG"
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
