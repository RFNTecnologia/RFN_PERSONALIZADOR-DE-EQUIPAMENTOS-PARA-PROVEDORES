# Configuracao do agente de restauracao do provedor (exemplo).
# Copie para /etc/rfn-agent.conf dentro do equipamento e ajuste os valores.
# O painel gera um arquivo pronto para cada equipamento (kit de implantacao).

# URL do servidor do provedor (mesma base usada pelo ACS).
RFN_SERVER=http://acs.seuprovedor.com.br:8080

# Token de bootstrap do dispositivo (RFN_DEVICE_TOKEN do servidor).
RFN_TOKEN=troque-este-token

# Serial de fabrica (opcional: o agente detecta quando ausente).
RFN_SERIAL=

# Identificador de provisionamento do provedor: grupo::modelo-carimbo-uid.
# E o que permite reconhecer o equipamento depois de um reset de fabrica.
RFN_IDENTIFICADOR=gru1::cx588-1793224550476-38f3d149b1ba

# Diretorio do web server do CPE (onde a tela de login e publicada).
RFN_LOGIN_DIR=/www

# Cache offline: precisa sobreviver ao reset de fabrica, por isso /mnt/rfn.
RFN_CACHE_DIR=/mnt/rfn
RFN_CACHE=/mnt/rfn/cache.env

# Tentativas e intervalo entre tentativas de bootstrap.
RFN_TENTATIVAS=60
RFN_INTERVALO=30

# Log do agente.
RFN_LOG=/var/log/rfn-agent.log
